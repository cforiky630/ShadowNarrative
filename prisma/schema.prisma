// Shadow Narrative — 数据库 schema
//
// 字段、索引、级联规则全部对应 docs/specs/08-DATA_API_SPEC.md §3。
// 改这里之前先改文档。
//
// ⚠️ 字段名不得随意改动。18-BACKUP_PROTOCOL.md §3 要求快照清单
// 「字段与 08 §3 的 schema 一一对应，键名一致，恢复时不需要映射表」——
// 这里随手改名，Round 11 就要多维护一层映射。
//
// 引擎是 SQLite（08 §2）。三处写法差异：
//   1. 不支持 enum        → 用 String，取值集合由 TS 联合类型约束（src/types）
//   2. Json 支持有限      → 统一用 String 存，应用层 JSON.parse / stringify
//   3. 不区分大小写 LIKE  → 用 COLLATE NOCASE，mode: 'insensitive' 无效
//
// 多租户：所有实体从第一天就带 userId。自托管阶段只有一个默认用户，
// 但多用户结构先留着，将来接登录时不用改数据模型（08 §1 硬约束 #1）。

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 起 datasource 不再接受 url —— 连接串由 prisma.config.ts 提供，
// 运行时则通过 driver adapter 传给 PrismaClient。见 prisma.config.ts 与 src/lib/dataDir.ts。
datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos    Photo[]
  memories  Memory[]
  dayThemes DayTheme[]
  settings  UserSettings?

  @@map("users")
}

/// 主实体。每一次上传生成一张独立的 Photo，自带文件、AI 理解、对话与日志。
model Photo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- 文件 ---
  storageKey   String  @unique // 原图
  thumbnailKey String? // 斜轴与列表用。像素处理属 Python 图像服务，尚未建（08 §6）
  // 明文文件字节的 SHA-256。本地身份与完整性校验用。
  // ⚠️ 绝不能直接当备份上行的 blob id —— 那会白送一个确认预言机。
  //    上行 id 须为 HMAC-SHA256(用户密钥, contentHash)，见 18 §2 与 Round 11。
  contentHash String

  mimeType String
  width    Int
  height   Int
  byteSize Int
  // EXIF 拍摄时间。没有就为 null，用 createdAt 兜底
  takenAt DateTime?

  // --- 用户提供 ---
  caption  String?
  favorite Boolean @default(false) // 收藏 → 出现在斜轴相册

  // --- AI 处理状态 ---
  aiState String  @default("pending") // pending | done | failed
  aiError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis     PhotoAnalysis?
  conversation Conversation?
  journal      Journal?
  groups       MemoryPhoto[]

  @@index([userId, favorite, takenAt])
  @@index([userId, createdAt])
  @@index([contentHash])
  @@map("photos")
}

/// AI 看图结果。结构见 09-AI_SPEC.md §8。
model PhotoAnalysis {
  id      String @id @default(cuid())
  photoId String @unique
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  payload String // 09 §8 的 JSON 字符串
  model   String
  // 发送给模型的内容摘要，用于「这张照片被发出去了什么」（12 §5）
  sentSummary String?

  createdAt DateTime @default(now())

  @@map("photo_analyses")
}

/// 挂在照片上。一个 Photo 一段对话。
model Conversation {
  id      String @id @default(cuid())
  photoId String @unique
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String // user | assistant
  content String
  // 证据来源 JSON（09 §6）
  sourceRefs String?
  // 这条是不是「字幕」—— 即 AI 在看到照片后主动说的第一句。
  // 字幕就是对话的第一条，不做两套数据（09 §21.1）；
  // 这个标记只决定它在前端以什么形式呈现（照片下安静浮现，而不是气泡）。
  isSubtitle Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

/// 随笔小记实体。1:1 挂载在照片上，由用户主动触发生成或书写（01 §9、08 §3）。
/// 核心特征：轻量随笔记录，仅保留正文与版本，无长文标题与定稿仪式。
model Journal {
  id      String @id @default(cuid())
  photoId String @unique
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  content String
  /// 乐观锁版本号：每次写入递增，PATCH 校验防止 AI 润色覆盖用户手工改动（08 §8）。
  sourceVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("journals")
}

/// 影册实体（01 §4、08 §9）。
/// 命名规则：UI 界面统一呈现为「影册」，代码模型与底层表沿用 `Memory`。
/// 核心特征：用户自主归类照片的轻量集合，仅维护标题与多对多关联关系。
model Memory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 影册标题，必填。
  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos MemoryPhoto[]

  /// 架子排序：最近更新/添加照片的影册优先展示
  @@index([userId, updatedAt])
  @@map("memories")
}

/// 影册与照片多对多关联实体。
/// 级联规则：删除影册仅断开关联关系，不删除照片本身（08 §4）。
/// 照片组内排序按拍摄时间在运行时完成，不依赖显式排序字段。
model MemoryPhoto {
  memoryId String
  photoId  String
  memory   Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  photo    Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([memoryId, photoId])
  @@index([photoId])
  @@map("memory_photos")
}

/// 时间线日节点主题（08 §17）。
/// 核心特征：天为主体刻度，主题名由用户明确命名（AI 不自动推测命名，符合 01 §9 约束）。
model DayTheme {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 本地日历日字符串 ("YYYY-MM-DD")，避免 UTC 时间转换导致的时区漂移。
  dayKey String

  title String
  /// 主题来源：user | ai（当前仅由用户主动命名）。
  source String @default("user")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dayKey])
  @@map("day_themes")
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 粒子偏好（06 §17）：用户全局观看偏好（默认预设为 drift）
  particlePreset String  @default("drift")
  particleParams String? // JSON

  // 备份配置（18-BACKUP_PROTOCOL.md）。备份凭据保存在 secrets.json，不落库（17 §4、18 §7）
  backupAuto     Boolean @default(false)
  backupEndpoint String?

  updatedAt DateTime @updatedAt

  @@map("user_settings")
}
